{
  "$schema": "https://toolbox.md/schemas/project-registry-v1.schema.json",
  "schema": 1,
  "projects": [
    {
      "id": "agentsmd",
      "repository": "toolboxmd/agentsmd",
      "kind": "agent-module",
      "projectRecordPath": ".toolboxmd/project.json",
      "deliveryProfilePath": ".toolboxmd/delivery.json",
      "distribution": {
        "type": "marketplace",
        "repository": "toolboxmd/marketplace",
        "recordPath": "plugins/agentsmd/SOURCE.json",
        "catalogPath": "catalog.json"
      },
      "website": {
        "repository": "toolboxmd/toolbox.md",
        "baseUrl": "https://toolbox.md",
        "route": "/agentsmd"
      },
      "review": {
        "reviewedMajor": 8
      }
    },
    {
      "id": "gitpix",
      "repository": "toolboxmd/gitpix",
      "kind": "app",
      "projectRecordPath": ".toolboxmd/project.json",
      "deliveryProfilePath": ".toolboxmd/delivery.json",
      "distribution": {
        "type": "project-deployment",
        "repository": "toolboxmd/gitpix",
        "recordPath": ".github/workflows/activate-release.yml"
      },
      "website": {
        "repository": "toolboxmd/toolbox.md",
        "baseUrl": "https://toolbox.md",
        "route": "/gitpix"
      },
      "review": {
        "reviewedMajor": 3
      }
    },
    {
      "id": "use-grok",
      "repository": "toolboxmd/use-grok",
      "kind": "agent-module",
      "projectRecordPath": ".toolboxmd/project.json",
      "deliveryProfilePath": ".toolboxmd/delivery.json",
      "distribution": {
        "type": "marketplace",
        "repository": "toolboxmd/marketplace",
        "recordPath": "catalog.json",
        "catalogPath": "catalog.json"
      },
      "website": {
        "repository": "toolboxmd/use-grok",
        "baseUrl": "https://github.com",
        "route": "/toolboxmd/use-grok"
      },
      "review": {
        "reviewedMajor": 0
      }
    }
  ]
}
