{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolbox.md/schemas/app-project-record-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "kind",
    "outcome",
    "factSources"
  ],
  "properties": {
    "$schema": {
      "const": "https://toolbox.md/schemas/app-project-record-v1.schema.json"
    },
    "id": {
      "const": "gitpix"
    },
    "kind": {
      "const": "app"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "factSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "delivery",
        "documentation",
        "requirements",
        "proof"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "release",
            "runtime",
            "activation"
          ],
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            },
            "runtime": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            },
            "activation": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
            }
          }
        },
        "documentation": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          }
        },
        "proof": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          }
        }
      }
    }
  }
}
